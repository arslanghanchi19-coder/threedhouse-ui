# Netlify > Project configuration > Environment variables (never commit values)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Auth > Users > copy your verified owner's UUID; NOT an email or password.
ADMIN_USER_IDS=
# Exact origin; use http://localhost:3000 locally and your HTTPS origin in Netlify.
SITE_URL=http://localhost:3000
# Leave off until schema, owner access and order tests are complete.
CHECKOUT_ENABLED=false
# Online payments are intentionally disabled in this migration package.

