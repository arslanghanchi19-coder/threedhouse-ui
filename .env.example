# Netlify > Project configuration > Environment variables (never commit values)
# Database: provisioned automatically via Netlify's Neon extension.
# Locally, run `netlify dev` (not `next dev`) so this connection is available.
# No manual connection string needed here.
# Auth: create a free app at https://clerk.com, then copy its API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Auth > Users > copy your signed-in owner's Clerk user ID (starts with user_).
ADMIN_USER_IDS=
# Exact origin; use http://localhost:8888 with `netlify dev` and your HTTPS origin in Netlify.
SITE_URL=http://localhost:8888
# Leave off until schema, owner access and order tests are complete.
CHECKOUT_ENABLED=false
# Online payments are intentionally disabled in this migration package.
